POST {{base}}/players
Content-Type: application/json

{ "name": "quebrado",

### 404: id não numérico, com zero à esquerda, rota inexistente, id inexistente
GET {{base}}/players/abc

###
GET {{base}}/players/01

###
GET {{base}}/players/0

###
GET {{base}}/inexistente

###
GET {{base}}/players/999999

###############################################################
# B03: campos do sistema ignorados, Location, base_value fixo
###############################################################

### esperado: 201, condition APTO, club_id null, base_value 40.00 (ignora o que veio)
# @name pExtra
POST {{base}}/players
Content-Type: application/json

{ "name": "Campos Extras", "position": "MEI", "agility": 85, "age": 25, "pace": 70, "shooting": 68, "passing": 82, "dribbling": 79, "defending": 55, "physical": 64, "potential": 86, "base_value": 999, "market_value": 999, "overall": 99, "condition": "DOENTE", "club_id": 1, "id": 777 }

### PUT não muda base_value (continua 40.00; overall pode mudar com a posição)
PUT {{base}}/players/{{pExtra.response.body.$.id}}
Content-Type: application/json

{ "name": "Campos Extras Editado", "position": "ATA", "agility": 90, "age": 30 }

###
GET {{base}}/players/{{pExtra.response.body.$.id}}

###############################################################
# B04: PUT e PATCH
###############################################################

### PUT inválido (sem position): 400
PUT {{base}}/players/{{pExtra.response.body.$.id}}
Content-Type: application/json

{ "name": "Sem Posicao", "agility": 90, "age": 30 }

### idade menor que a atual (30 -> 29): 409
PUT {{base}}/players/{{pExtra.response.body.$.id}}
Content-Type: application/json

{ "name": "Campos Extras Editado", "position": "ATA", "agility": 90, "age": 29 }

### PATCH condition ausente / inválida: 400
PATCH {{base}}/players/{{pDoente.response.body.$.id}}/condition
Content-Type: application/json

{}

###
PATCH {{base}}/players/{{pDoente.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "doente" }

### vai para DOENTE: 200
PATCH {{base}}/players/{{pDoente.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "DOENTE" }

### DOENTE direto para APTO: 409
PATCH {{base}}/players/{{pDoente.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "APTO" }

### DOENTE -> MAL_CONDICIONADO: 200, e mesma condição de novo: 200
PATCH {{base}}/players/{{pDoente.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "MAL_CONDICIONADO" }

###############################################################
# B05 e B06: valor de mercado, overall, valor base
###############################################################

### Meia Lua MAL_CONDICIONADO, agilidade 85, idade 25: market_value 37.00
PATCH {{base}}/players/{{pMeia.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "MAL_CONDICIONADO" }

### Veterano (age 40, agilidade 10) DOENTE: -30%-10pp = -40%, idade -10% -> teto -40%: market_value 24.00
PATCH {{base}}/players/{{pVet.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "DOENTE" }

### Jovem Lua APTO: base 44.40, market 48.84
GET {{base}}/players/{{pJovem.response.body.$.id}}

###############################################################
# B07: listagem
###############################################################

### paginação e meta
GET {{base}}/players?page=1&limit=3

### página além da última: 200 com data []
GET {{base}}/players?page=999&limit=10

### busca sem acento e sem diferenciar maiúscula
GET {{base}}/players?search=LUA

###
GET {{base}}/players?search=veteráno

### filtros combinados
GET {{base}}/players?position=MEI&condition=APTO&free=true&min_age=18&max_age=30&min_value=10&max_value=100

### ordenações (ajuste o nome se o seu sort usa outro)
GET {{base}}/players?sort=value_desc

###
GET {{base}}/players?sort=value_asc

###
GET {{base}}/players?sort=age_desc

###
GET {{base}}/players?sort=name

###
GET {{base}}/players?sort=position

### sort com 2 critérios (o formato é o do README.md, seção de query params)
GET {{base}}/players?sort=position,value_desc

### inválidos: 400
GET {{base}}/players?sort=xyz

###
GET {{base}}/players?page=0

###
GET {{base}}/players?limit=1000

###
GET {{base}}/players?min_age=40&max_age=20

###
GET {{base}}/players?free=true&club_id=1

###
GET {{base}}/players?position=mei

###############################################################
# B08: exclusão lógica
###############################################################

### 204 sem corpo
DELETE {{base}}/players/{{pDel.response.body.$.id}}

### depois, tudo 404
GET {{base}}/players/{{pDel.response.body.$.id}}

###
PUT {{base}}/players/{{pDel.response.body.$.id}}
Content-Type: application/json

{ "name": "Para Excluir", "position": "ATA", "agility": 60, "age": 25 }

###
PATCH {{base}}/players/{{pDel.response.body.$.id}}/condition
Content-Type: application/json

{ "condition": "APTO" }

###
DELETE {{base}}/players/{{pDel.response.body.$.id}}

### não aparece na lista
GET {{base}}/players?search=excluir

