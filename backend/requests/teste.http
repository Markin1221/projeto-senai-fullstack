###############################################################
# B10 a B13: compra
###############################################################

### compra OK: 200, value 37.00, fee 1.85, club_cash 261.15, contrato ATIVO
POST {{base}}/players/{{pMeia.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2027-03-02T10:15-03:00" }

### jogador que já tem clube: 409 (outro clube tentando)
POST {{base}}/players/{{pMeia.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cB.response.body.$.id}}, "loyalty_until": "2027-03-02T10:15-03:00" }

### jogador excluído: 404
POST {{base}}/players/{{pDel.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cB.response.body.$.id}}, "loyalty_until": "2027-03-02T10:15-03:00" }

### club_id inexistente: 404
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": 999999, "loyalty_until": "2027-03-02T10:15-03:00" }

### club_id inválido: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": "abc", "loyalty_until": "2027-03-02T10:15-03:00" }

### loyalty_until ausente: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}} }

### formato sem -03:00: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2027-03-02T10:15" }

### com Z em vez de -03:00: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2027-03-02T10:15Z" }

### data no passado: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2020-01-01T10:00-03:00" }

### mais de 1.095 dias: 400
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2030-12-31T10:15-03:00" }

### segunda compra (Jovem Lua, 48.84 + taxa 2.44): 200
POST {{base}}/players/{{pJovem.response.body.$.id}}/buy
Content-Type: application/json

{ "club_id": {{cA.response.body.$.id}}, "loyalty_until": "2026-12-20T10:00-03:00" }

### clube com elenco: caixa, squad_value, net_worth, elenco na ordem, contrato
GET {{base}}/clubs/{{cA.response.body.$.id}}

# Limite de 50% do caixa e de 12 jogadores: precisa de mais jogadores caros / 12 compras (veja o fim do arquivo).

