@base = http://localhost:3000/api/v1

###############################################################
# SETUP: jogadores e clubes usados nos testes seguintes
###############################################################

# @name pMeia
POST {{base}}/players
Content-Type: application/json

{ "name": "Meia Lua", "position": "MEI", "agility": 85, "age": 25, "pace": 70, "shooting": 68, "passing": 82, "dribbling": 79, "defending": 55, "physical": 64, "potential": 86 }
# esperado: 201 + Location, base_value 40.00, overall 75, condition APTO, club_id null

###
# @name pVet
POST {{base}}/players
Content-Type: application/json

{ "name": "Veterano", "position": "MEI", "agility": 10, "age": 40, "pace": 70, "shooting": 68, "passing": 82, "dribbling": 79, "defending": 55, "physical": 64, "potential": 86 }

###
# @name pJovem
POST {{base}}/players
Content-Type: application/json

{ "name": "Jovem Lua", "position": "MEI", "agility": 85, "age": 19, "pace": 70, "shooting": 68, "passing": 82, "dribbling": 79, "defending": 55, "physical": 64, "potential": 86 }
# esperado: base_value 44.40 (40 x 1,11), market_value 48.84 (+10% jovem)

###
