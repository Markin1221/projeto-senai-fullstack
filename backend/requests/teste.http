PUT {{base}}/players/{{pJovem.response.body.$.id}}
Content-Type: application/json

{ "name": "Jovem Lua Renomeado", "position": "MEI", "agility": 85, "age": 19 }

###
GET {{base}}/clubs/{{cA.response.body.$.id}}/transactions

### CSV: text/csv, UTF-8 sem BOM, LF, ";" e vírgula decimal
